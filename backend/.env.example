# ═══════════════════════════════════════════════════════════════════════
# iBitPlay — single source of configuration for every service.
# Copy to `.env` and edit. Never commit `.env`.
#
#   cp .env.example .env
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ═══════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
# Pretty-print logs in dev (requires pino-pretty); JSON when false.
LOG_PRETTY=true

# ── Database — ONE PostgreSQL database shared by all services ──────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ibitplay
DB_USER=postgres
# ⚠ A DEFAULT PASSWORD. Fine on a loopback-only developer database; anyone who
# can reach the port owns every player record, balance and password hash.
# `assertProductionPosture` REFUSES TO BOOT on this value when NODE_ENV=production,
# so a deploy that inherits this file fails loudly rather than quietly.
DB_PASSWORD=postgres
DB_SCHEMA=public
DB_SSL=false
# Log every SQL statement (very noisy — dev debugging only)
DB_LOGGING=false
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000
# Fail a query that runs longer than this (ms). Protects against runaway locks.
DB_STATEMENT_TIMEOUT_MS=30000

# ── Per-service database roles (optional, but do set them) ─────────────
# Without these, all four services connect as DB_USER with full rights on every
# table — so a compromise of the service that polls an odds feed is a
# compromise of every player record, balance and password hash.
#
# Create the roles and print the values with:
#   node tools/db-grants.js --apply
# Verify afterwards with:
#   npm run db:grants:check
#
# Unset a pair and that service falls back to DB_USER, unchanged — roles can be
# adopted one service at a time. Migrations still run as DB_USER; a scoped role
# has no DDL rights.
DB_USER_USER_SERVICE=
DB_PASSWORD_USER_SERVICE=
DB_USER_ADMIN_SERVICE=
DB_PASSWORD_ADMIN_SERVICE=
DB_USER_CASINO_SERVICE=
DB_PASSWORD_CASINO_SERVICE=
DB_USER_SPORTS_SERVICE=
DB_PASSWORD_SPORTS_SERVICE=

# ── JWT (player tokens) ────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-only-access-secret-replace-me-with-64-random-hex-chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-me-with-64-random-hex-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=ibitplay
JWT_AUDIENCE=ibitplay-api

# ── JWT (staff/admin tokens — deliberately separate keys) ──────────────
JWT_ADMIN_SECRET=dev-only-admin-secret-replace-me-with-64-random-hex-chars
JWT_ADMIN_TTL=8h

# ── Second-factor secrets (encryption at rest) ─────────────────────────
# A TOTP shared secret cannot be hashed — generating the code the phone shows
# needs the original — so it is encrypted with AES-256-GCM instead. Before this
# it sat in `users.two_fa` as plain base32, which made any copy of the database
# enough to mint valid codes for every enrolled account.
#
# 32 bytes, hex. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ROTATING THIS MAKES EVERY STORED 2FA SECRET UNREADABLE. There is no
# re-encryption pass — everyone enrolled would have to enrol again. Treat it
# like the JWT secrets.
#
# Leave it unset and the key is derived from JWT_ADMIN_SECRET with a loud
# warning on every boot. That still encrypts, but couples the two: rotating
# JWT_ADMIN_SECRET would then silently lock out everyone enrolled.
TOTP_ENCRYPTION_KEY=

# ── Service-to-service auth ────────────────────────────────────────────
# Presented as `x-internal-key` on every /internal/* route. Services refuse
# internal calls without it, and the gateway never proxies /internal/*.
INTERNAL_API_KEY=dev-only-internal-key-replace-me-with-64-random-hex-chars

# ── Per-service internal keys (optional, but do set them) ──────────────
# INTERNAL_API_KEY above proves a caller is "one of our services" and nothing
# more, so any service can reach any internal endpoint — including
# POST /internal/user/wallet/credit, which mints balance. A per-service key
# identifies WHICH service is calling, which is what makes the ACL in
# packages/common/src/internalAcl.js enforceable, and makes the caller name on
# audit rows a fact rather than a self-declared header.
#
# ALL FOUR OR NONE: until every one is set the platform falls back to the
# shared key and skips the ACL, so a partial rollout cannot half-enforce.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_KEY_USER_SERVICE=
INTERNAL_KEY_ADMIN_SERVICE=
INTERNAL_KEY_CASINO_SERVICE=
INTERNAL_KEY_SPORTS_SERVICE=

# ── Ports ──────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
USER_SERVICE_PORT=4001
ADMIN_SERVICE_PORT=4002
CASINO_SERVICE_PORT=4003
SPORTS_SERVICE_PORT=4004

# ── User background worker (services/user/src/worker.js) ───────────────
# Run as its OWN process, not inside the HTTP service:
#   npm run start:user-worker
#
# It rolls and settles the wagering races. RUN EXACTLY ONE. Nothing here takes
# an advisory lock — the race tables' unique constraints make a second worker
# harmless rather than correct, and two workers each build a full leaderboard
# every five minutes for no benefit.
#
# THE PROMOTION DOES NOT RUN WITHOUT IT. No worker means no race window opens
# and none ever settles: the site keeps serving the last standings behind a
# countdown that has passed zero, which is exactly how the implementation this
# was ported from went unnoticed for three days.
USER_WORKER_PORT=4101

# Whose day a race runs on — its windows are local midnight to local midnight,
# and the weekly one runs local Monday to Monday. Any IANA zone; DST is handled.
RACE_TIMEZONE=Asia/Kolkata

# ── Service discovery ──────────────────────────────────────────────────
USER_SERVICE_URL=http://127.0.0.1:4001
ADMIN_SERVICE_URL=http://127.0.0.1:4002
CASINO_SERVICE_URL=http://127.0.0.1:4003
SPORTS_SERVICE_URL=http://127.0.0.1:4004
# Timeout + retry policy for inter-service HTTP calls
SERVICE_TIMEOUT_MS=8000
SERVICE_RETRIES=2

# ── HTTP ───────────────────────────────────────────────────────────────
# Comma-separated allowed origins, or * for any.
# :3003 is the player app, :3001 the admin panel. An origin missing here is
# refused by the CORS check and surfaces in the browser as a CORS error.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:5173
BODY_LIMIT=1mb
# Number of proxy hops to trust for client IP (0 disables).
TRUST_PROXY=1
REQUEST_TIMEOUT_MS=30000

# ── Rate limiting ──────────────────────────────────────────────────────
# Master switch. Set false ONLY for automated test runs, where hundreds of
# logins arrive from one address and would trip every bucket.
# Never false in any environment reachable from the internet.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Tighter bucket for login/register/password endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Registration, metered separately from login.
#
# Per IP — and a household, an office or a mobile carrier is ONE IP here, so
# a tight value locks out real people who share a connection. 20/hour keeps
# bulk account creation expensive without punishing NAT.
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=20
# Bucket for money movement (bets, withdrawals, transfers)
WALLET_RATE_LIMIT_WINDOW_MS=60000
WALLET_RATE_LIMIT_MAX=60

# ── Redis (optional) — shared rate-limit store + notification queue ────
# Leave blank to run fully in-memory (single-process dev).
REDIS_URL=
REDIS_PREFIX=ibitplay

# ── Wallet ─────────────────────────────────────────────────────────────
BASE_CURRENCY=USDT
SUPPORTED_CURRENCIES=USDT,BTC,ETH,LTC,TRX,DOGE,INR
# Ledger amounts are stored as NUMERIC with this many decimal places.
CURRENCY_SCALE=8
MIN_DEPOSIT_USDT=10
MIN_WITHDRAWAL_USDT=20
# Withdrawals at or below this amount skip manual review (0 = always review).
WITHDRAWAL_AUTO_APPROVE_LIMIT=0
# Allow a bet to be placed when the balance is exactly the stake.
ALLOW_ZERO_BALANCE_AFTER_BET=true

# ── Casino ─────────────────────────────────────────────────────────────
CASINO_HOUSE_EDGE=2
CASINO_MIN_BET=0.10
CASINO_MAX_BET=10000
# Rotate a player's provably-fair seed pair after this many rounds (0 = manual)
CASINO_SEED_ROTATE_AFTER=0

# ── Casino seamless wallet (the provider's bet/win callbacks) ─────────
# Every bet and every win is an HTTP call to us on /api/seamless/*.
# The key below was HARD-CODED in legacy/index.js and is in the repository
# history — rotate it with the provider before going live.
SEAMLESS_SECRET_KEY=
SEAMLESS_OPERATOR_CODE=

# How stale a request_time may be, in seconds. The provider's signature covers
# only the action name, so without this a captured signature works forever.
SEAMLESS_MAX_SKEW_SECONDS=300

# `legacy` = the provider's documented scheme (action name only).
# `full`    = also signs the member, transaction ids and amounts. Use this if
#             the provider supports it; it removes the replay problem entirely.
SEAMLESS_SIGN_MODE=legacy

# ── Sports ─────────────────────────────────────────────────────────────
SPORTS_MIN_STAKE=1
SPORTS_MAX_STAKE=50000
SPORTS_MAX_SELECTIONS=20
# Max total payout allowed on a single betslip, in BASE_CURRENCY.
SPORTS_MAX_PAYOUT=100000
# ── Sports data provider ───────────────────────────────────────────────
# Odds, in-play scores and match RESULTS come from here. Both are REQUIRED and
# sports-service refuses to start without them.
#
# Legacy hardcoded `http://46.202.164.63:6565/api` in nine controllers, with
# `process.env.SCORESWIFT_KEY || 'bit_wyusjkwiyu'` beside it — so a deployment
# that never set the variable worked anyway, using the key committed to this
# repository. That key must be treated as compromised.
#
# The url must be https. Results arriving in cleartext means anyone on the
# network path between here and the provider can decide who won a match.
SPORTS_FEED_URL=https://feed.example.com/api
SPORTS_FEED_KEY=
SPORTS_FEED_TIMEOUT_MS=8000
# Accept a plain-http feed. Only set this if you understand that it lets an
# attacker on the path rewrite odds and results in transit.
SPORTS_FEED_ALLOW_INSECURE=false
# Which day "today" and "tomorrow" mean on the fixture endpoints. Legacy
# hardcoded the IST offset as `utcOffset(330)`, which cannot follow DST.
SPORTS_FEED_TIMEZONE=Asia/Kolkata
# How long the global sports on/off flag is cached before asking admin-service
# again. Legacy ran `SELECT sports FROM siteconfig LIMIT 1` on every request.
SPORTS_ENABLED_TTL_MS=5000

# ── Sports background worker (services/sports/src/worker.js) ───────────
# Run as its OWN process, not inside the HTTP service:
#   npm run start:sports-worker
# Scale HTTP instances freely; the write jobs below take a Postgres advisory
# lock, so running several workers is safe but only one settles at a time.
SPORTS_WORKER_PORT=4104

# Event lists change slowly, odds change constantly.
SPORTS_FEED_POLL_MS=60000
SPORTS_ODDS_POLL_MS=2000

# Result polling. MIN_AGE skips matches too recent to have finished;
# RATE_LIMIT is the gap between provider calls (this feed throttles hard).
SPORTS_RESULT_POLL_MS=60000
SPORTS_RESULT_MIN_AGE_MS=7200000
SPORTS_RESULT_BATCH=50
SPORTS_RESULT_RATE_LIMIT_MS=250

# Settlement. Small batches keep the advisory-lock hold short, so a manual
# settlement from the admin panel is not blocked behind a long run.
SPORTS_SETTLEMENT_INTERVAL_MS=60000
SPORTS_SETTLEMENT_BATCH=20
# Give up after this many attempts; the row is left 'failed' for manual review.
SPORTS_SETTLEMENT_MAX_ATTEMPTS=5

SPORTS_HOUSEKEEPING_INTERVAL_MS=900000

# ── Auth policy ────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
# Lock the account after N consecutive failed logins, for M minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Require a verified email before the account can transact.
REQUIRE_EMAIL_VERIFICATION=false
TOTP_ISSUER=iBitPlay
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=24
# Max simultaneous refresh tokens (sessions) per player; oldest is revoked.
MAX_ACTIVE_SESSIONS=10

# ── Email (SMTP) ───────────────────────────────────────────────────────
# Leave SMTP_HOST blank and nothing is sent — and nothing pretends to have
# been: a verification code that could not be delivered is reported to the
# player as a failure. That is the dev default; there is no dry-run mode.
SMTP_HOST=
# TLS is implied by the port: 465 connects over TLS, anything else uses
# STARTTLS. There is no separate switch — see packages/common/src/mailer.js.
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_DRY_RUN=true
# Concurrent connections held open to the SMTP host.
SMTP_MAX_CONNECTIONS=5
MAIL_FROM="iBitPlay <no-reply@ibitplay.local>"

# ── Telegram alerts (finance events) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_BYTES=5242880
PUBLIC_ASSET_URL=http://localhost:4000/assets

# ── Bootstrap admin (created by `npm run db:seed`) ─────────────────────
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=admin@ibitplay.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
# Seed a demo player + demo casino/sports catalogue for local development.
SEED_DEMO_DATA=true

# ── Identity documents ────────────────────────────────────────────────
# Where KYC uploads are written. Must NOT be inside a directory any web
# server serves — documents are readable only through the authorised
# endpoint, which verifies ownership first.
KYC_STORAGE_DIR=./storage/kyc
DEPOSIT_STORAGE_DIR=./storage/deposits

# ── Payment providers ─────────────────────────────────────────────────
# Every callback is cryptographically verified before it can move money.
# A provider whose secret is blank REFUSES callbacks rather than accepting
# unverified ones — the legacy UPI webhook had no verification at all.
WAYPAY_MERCHANT_KEY=
APAY_WEBHOOK_ACCESS_KEY=
APAY_WEBHOOK_PRIVATE_KEY=
CRICPAY_SECRET_KEY=
CRICPAY_SECRET_IV=
# CricPay's encrypted callback says an amount succeeded but not WHICH
# transaction — that sits in a plaintext field anyone can change. So the
# outcome is confirmed with CricPay before crediting, and these two are
# required for a CricPay payment to settle at all, not just to call the API.
CRICPAY_MERCHANT_CODE=
CRICPAY_BASE_URL=https://prodapi.cricpayz.io:14495
UPI_WEBHOOK_SECRET=

# How long to wait on a provider before treating it as unreachable (ms).
PSP_TIMEOUT_MS=10000

# ── Outbound provider credentials (starting a payment) ────────────────
# These authenticate US to the provider; the secrets above authenticate the
# provider to us. Every one of these was hard-coded in the legacy source, so
# the values currently in production are in the repository history and must be
# rotated with each provider before this goes live.
WAYPAY_BASE_URL=https://api.wpay.one
APAY_API_KEY=
APAY_PROJECT_ID=
APAY_BASE_URL=https://pay-crm.com
APAY_RETURN_URL=
APAY_DEPOSIT_WEBHOOK_ID=
APAY_WITHDRAWAL_WEBHOOK_ID=
UPI_API_KEY=
UPI_BASE_URL=https://api.ekqr.in
UPI_REDIRECT_URL=
UPI_CUSTOMER_EMAIL=

# CCPayment — crypto deposits. The App ID and secret come from the CCPayment
# merchant dashboard; the secret both signs our outbound calls AND verifies
# their webhook, so one blank value disables deposits in both directions.
#
# Give CCPayment this callback URL, built from PUBLIC_BASE_URL below:
#   POST <PUBLIC_BASE_URL>/api/v1/user/crypto/ccpayment/callback
#
# BASE_URL is the API ORIGIN ONLY — the code appends `/ccpayment/v2/...`
# itself. Take it from the provider's current docs rather than assuming; the
# host appears nowhere in this repository or in the legacy source, so there is
# no value here to inherit.
CCPAYMENT_APP_ID=
CCPAYMENT_APP_SECRET=
CCPAYMENT_BASE_URL=

# Where providers send their callbacks. Must be OUR public origin — this is
# what builds the notify_url, which legacy took from the request body.
PUBLIC_BASE_URL=http://localhost:8080

# The player-facing SITE. Referral links point here. Legacy hard-coded
# https://addaplay.com into the affiliate controller, so every non-production
# environment handed players a link to production.
PUBLIC_SITE_URL=http://localhost:3000

# ── Payment limits ────────────────────────────────────────────────────
# Legacy enforced none in either direction.
DEPOSIT_MINIMUM=1
DEPOSIT_MAXIMUM=1000000
WITHDRAW_MAXIMUM=500000

# Master switch for provider-initiated payouts. OFF by default — turning this
# on should be a deliberate act by someone who has checked the credentials and
# the limits above.
AUTO_WITHDRAWALS_ENABLED=false

# ── jsGames v2 (games.ibitplay.com) ───────────────────────────────────
# The casino lobby's game source. `casino/js-games/v2/games` lists the
# catalogue and `casino/js-games/v2/launch` returns the URL a game opens in.
#
# All three below are REQUIRED together — XGamesApiClient.configured checks
# baseUrl && apiKey && apiSecret, and every v2 route answers
# 503 JSGAMES_NOT_CONFIGURED until all three are set.
#
# The key/secret pair signs both directions: outbound calls send
# x-api-key + x-timestamp + x-signature (HMAC-SHA256 over the sorted body),
# and inbound bet-callbacks are verified with the same scheme.
#
# The legacy pair was committed in plain text in `legacy/jsgamesv2/config.js`
# and is in the repository history. Get a fresh pair from the provider.
JSGAMES_V2_BASE_URL=https://games.ibitplay.com/api/game
JSGAMES_V2_API_KEY=
JSGAMES_V2_API_SECRET=

# Give the provider: <public origin>/api/v1/casino/js-games/v2/bet-callback
JSGAMES_CALLBACK_URL=
# Where a player lands when they close a game.
JSGAMES_HOME_URL=
# How stale an inbound callback timestamp may be, in seconds — the replay window.
JSGAMES_MAX_SKEW_SECONDS=300
# Upstream HTTP timeout for provider calls, in milliseconds.
JSGAMES_TIMEOUT_MS=15000

# ── jsGames v1 (huidu.bet) — legacy, off by default ───────────────────
# Leave AGENCY_UID and AES_KEY empty to keep every v1 provider route
# refusing. The v1 game LIST still answers regardless: it reads the local
# `js_games` table rather than the provider.
# AES_KEY must be exactly 32 bytes (aes-256) or the client stays unconfigured.
# The legacy values are also in the repository history — rotate before use.
JSGAMES_V1_BASE_URL=https://huidu.bet
JSGAMES_V1_AGENCY_UID=
JSGAMES_V1_AES_KEY=
JSGAMES_V1_PLAYER_PREFIX=h24e9e
