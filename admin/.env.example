# Where this admin's platform gateway is (server-side only; the browser talks to /api/gw/*)
API_URL=http://127.0.0.1:4000

# Identity of the site this admin build serves. Written by the owner panel when it provisions a site.
NEXT_PUBLIC_SITE_KEY=admins
NEXT_PUBLIC_SITE_NAME=CFZ Site Admin
NEXT_PUBLIC_SITE_TAGLINE=Operator panel
NEXT_PUBLIC_ENV_LABEL=localhost

# Session cookie (httpOnly). 8h matches the platform's JWT_ADMIN_TTL.
SESSION_COOKIE_NAME=cfz_sa_token
SESSION_MAX_AGE_SECONDS=28800
