# Copy to `.env` to override. Both are optional — the defaults work for
# `node scripts/dev.js user admin casino gateway` in ../backend.

# Where the dev server proxies /api and /health. The gateway, never a service
# port: 4001-4004 are internal and /internal/* is refused at the edge.
VITE_GATEWAY_URL=http://127.0.0.1:4000

# What the client prefixes onto every request. Left unset it is `/api/v1`,
# which the proxy above forwards — so the browser stays same-origin and CORS
# never comes up. Set it to an absolute origin to call a deployed API instead,
# and add that origin to CORS_ORIGIN in ../backend/.env when you do.
# VITE_API_BASE=https://api.example.com/api/v1
