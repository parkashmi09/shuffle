# Admin panel — the operator console.
#
# Copy to `.env` and adjust. Every value has a working local default, so an
# empty file runs against `npm run dev` in ../backend.
#
# Create React App only exposes variables prefixed `REACT_APP_`.

# ── HTTP ─────────────────────────────────────────────────────────────────
#
# The GATEWAY origin — the one public entry point.
#
# Note that the staff-facing routes of ALL FOUR services live under
# `/api/v1/admin/…`: `admin` is an AUDIENCE, not a service. So
# `/api/v1/admin/user/wallet` is user-service and `/api/v1/admin/staff` is
# admin-service, and both come through this one origin.
REACT_APP_API_BASE_URL=http://127.0.0.1:4000

# ── SOCKET ───────────────────────────────────────────────────────────────
#
# admin-service's own port. Sockets do not go through the gateway — it has no
# `upgrade` handling, so a websocket opened against :4000 never arrives.
#
# There is no namespace suffix. The old client connected to `/admin-panel`,
# which is a Socket.io NAMESPACE, and the transport registers everything on the
# default one — so that connection never reached a handler.
#
# The backend's SOCKET_ALLOWED_ORIGINS must list this app's origin.
REACT_APP_ADMIN_SOCKET_URL=http://127.0.0.1:4002
